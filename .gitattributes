# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# List text files in case git doesn't characterize correctly
*.c text
*.h text
*.s text
*.in text
*.js text
*.md text
*.py text
*.sh text
*.ld text
*.inc text
*.txt text
# Native-math audit contracts and route oracles participate in byte-for-byte
# release identity. Keep their checked-out representation canonical on Windows.
tools/saturn/sh2_native_math_*.txt text eol=lf
# JSON participates in several byte-for-byte release identities. Pin LF even
# when a Windows checkout enables core.autocrlf so canonical JSON stays
# canonical in the working tree as well as in the Git object database.
*.json text eol=lf
*.yaml text

# Same for binary
*.bin binary
*.m64 binary
*.png binary
*.aiff binary

# Vendored, unmodified GCC runtime sources. The rules above would check these
# out with CRLF, which would make the working tree differ byte-for-byte from
# upstream and undercut the "unmodified" statement in
# third_party/gcc-soft-fp/README.md and THIRD_PARTY_LICENSES.md. Keep them
# exactly as they came. (README.md is ours and stays under the normal rules.)
third_party/gcc-soft-fp/soft-fp/** -text
third_party/gcc-soft-fp/include/** -text
third_party/gcc-soft-fp/config/** -text
