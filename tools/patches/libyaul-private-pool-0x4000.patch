--- a/libyaul/kernel/mm/internal.c
+++ b/libyaul/kernel/mm/internal.c
@@ -5,6 +5,18 @@
  * Israel Jacquez <mrkotfw@gmail.com>
  */
 
+/* sm64-saturn-port Sprint 2 T2.2 (header of
+ * tools/patches/libyaul-private-pool-0x4000.patch has the full record):
+ * MALLOC_IMPL_TLSF mirrors the pinned toolchain build configuration
+ * (.yaul.env YAUL_OPTION_MALLOC_IMPL=tlsf -> libyaul env.mk
+ * -DMALLOC_IMPL_TLSF).  This translation unit is compiled by the port
+ * build, outside libyaul's env.mk, so the configuration macro must
+ * travel with the file for the user-pool behavior to stay identical to
+ * the installed libyaul.a. */
+#ifndef MALLOC_IMPL_TLSF
+#define MALLOC_IMPL_TLSF 1
+#endif
+
 #include <sys/cdefs.h>
 
 #include <mm/tlsf.h>
@@ -19,7 +31,12 @@
 #define TLSF_HANDLE_COUNT         (2)
 
 #define TLSF_POOL_PRIVATE_START ((uint32_t)&_private_pool[0])
-#define TLSF_POOL_PRIVATE_SIZE  (0xA000)
+/* sm64-saturn-port Sprint 2 T2.2: 0xA000 -> 0x4000.  T2.1 measured the
+ * pool's historical extent at 8,276 bytes from base (TLSF control 3,188 +
+ * 6 boot-time blocks, zero churn over 24,000 frames); a 0x4000 pool
+ * leaves 8,108 bytes of margin over that extent.  Evidence:
+ * docs/saturn/evidence/reports/sprint2-t2_1-peak-capture.md (Peak 2). */
+#define TLSF_POOL_PRIVATE_SIZE  (0x4000)
 
 #define TLSF_POOL_USER_START    ((uint32_t)&__end)
 #define TLSF_POOL_USER_END      (HWRAM(HWRAM_SIZE))
