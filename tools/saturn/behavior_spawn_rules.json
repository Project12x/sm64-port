{
  "schema": "sm64-saturn-behavior-spawn-rules-v1",
  "rules": [
    {"behavior":"bhvGoombaTripletSpawner","source":"src/game/behaviors/goomba.inc.c","reason":"The bounded triplet count is computed from behavior parameters; BOB uses the default three.","children":[{"model":"MODEL_GOOMBA","behavior":"bhvGoomba","maximum_instances":3}]},
    {"behavior":"bhvWaterBombSpawner","source":"src/game/behaviors/water_bomb.inc.c","reason":"The spawn call is in the native update loop, not the BehaviorScript.","children":[{"model":"MODEL_WATER_BOMB","behavior":"bhvWaterBomb","maximum_instances":1}]},
    {"behavior":"bhvBobBowlingBallSpawner","source":"src/game/behaviors/bowling_ball.inc.c","reason":"The model-less BOB controller creates rolling balls in its native update loop.","children":[{"model":"MODEL_BOWLING_BALL","behavior":"bhvBowlingBall","maximum_instances":1}]},
    {"behavior":"bhvTtmBowlingBallSpawner","source":"src/game/behaviors/bowling_ball.inc.c","reason":"The model-less alternate-act controller uses the same native rolling-ball spawn path.","children":[{"model":"MODEL_BOWLING_BALL","behavior":"bhvBowlingBall","maximum_instances":1}]},
    {"behavior":"bhvWaterBomb","source":"src/game/behaviors/water_bomb.inc.c","reason":"The shadow is created by native water-bomb initialization.","children":[{"model":"MODEL_WATER_BOMB_SHADOW","behavior":"bhvWaterBombShadow","maximum_instances":1}]},
    {"behavior":"bhvWaterBombCannon","source":"src/game/behaviors/water_bomb_cannon.inc.c","reason":"Native cannon state creates projectiles and barrel bubbles.","children":[{"model":"MODEL_WATER_BOMB","behavior":"bhvWaterBomb","maximum_instances":1},{"model":"MODEL_CANNON_BARREL","behavior":"bhvCannonBarrelBubbles","maximum_instances":1}]},
    {"behavior":"bhvBobomb","source":"src/game/behaviors/bobomb.inc.c","reason":"Explosion, fuse smoke, and coin reward originate in native logic.","children":[{"model":"MODEL_EXPLOSION","behavior":"bhvExplosion","maximum_instances":1},{"model":"MODEL_SMOKE","behavior":"bhvBobombFuseSmoke","maximum_instances":1},{"model":"MODEL_YELLOW_COIN","behavior":"bhvYellowCoin","maximum_instances":1}]},
    {"behavior":"bhvChainChomp","source":"src/game/behaviors/chain_chomp.inc.c","reason":"Native initialization makes chain parts and destruction produces the bounded coin reward.","children":[{"model":"MODEL_METALLIC_BALL","behavior":"bhvChainChompChainPart","maximum_instances":5},{"model":"MODEL_YELLOW_COIN","behavior":"bhvYellowCoin","maximum_instances":5}]},
    {"behavior":"bhvKoopa","source":"src/game/behaviors/koopa.inc.c","reason":"Native Koopa transitions create shell, smoke, and race star objects.","children":[{"model":"MODEL_KOOPA_SHELL","behavior":"bhvKoopaShell","maximum_instances":1},{"model":"MODEL_SMOKE","behavior":"bhvWhitePuffSmoke2","maximum_instances":1},{"model":"MODEL_STAR","behavior":"bhvStar","maximum_instances":1}]},
    {"behavior":"bhvKingBobomb","source":"src/game/behaviors/king_bobomb.inc.c","reason":"The victory star is emitted through native helper calls.","children":[{"model":"MODEL_STAR","behavior":"bhvStar","maximum_instances":1}]},
    {"behavior":"bhvBreakableBoxSmall","source":"src/game/behaviors/breakable_box_small.inc.c","reason":"Native break handling emits smoke and reward coins.","children":[{"model":"MODEL_SMOKE","behavior":"bhvSmoke","maximum_instances":1},{"model":"MODEL_YELLOW_COIN","behavior":"bhvYellowCoin","maximum_instances":3}]},
    {"behavior":"bhvBreakableBox","source":"src/game/behaviors/breakable_box.inc.c","reason":"Native break handling creates its configured coin reward.","children":[{"model":"MODEL_YELLOW_COIN","behavior":"bhvYellowCoin","maximum_instances":1}]},
    {"behavior":"bhvCoinFormation","source":"src/game/behaviors/coin.inc.c","reason":"Formation layout is computed in native code and instantiates eight coin-forming children.","children":[{"model":"MODEL_YELLOW_COIN","behavior":"bhvCoinFormationSpawn","maximum_instances":8}]},
    {"behavior":"bhvHiddenStar","source":"src/game/behaviors/hidden_star.inc.c","reason":"Native hidden-star completion creates a star outside the BehaviorScript.","children":[{"model":"MODEL_STAR","behavior":"bhvStar","maximum_instances":1}]},
    {"behavior":"bhvHiddenRedCoinStar","source":"src/game/behaviors/spawn_star.inc.c","reason":"Native red-coin completion invokes spawn_red_coin_cutscene_star.","children":[{"model":"MODEL_STAR","behavior":"bhvStar","maximum_instances":1},{"model":"MODEL_TRANSPARENT_STAR","behavior":"bhvRedCoinStarMarker","maximum_instances":1}]}
  ]
}
