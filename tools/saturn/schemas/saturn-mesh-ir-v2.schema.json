{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project12x.github.io/sm64-port/schemas/saturn-mesh-ir-v2.schema.json",
  "title": "SM64 Saturn source mesh IR v2",
  "type": "object",
  "required": ["schema", "version", "name", "static_world_space", "positions", "materials", "triangles"],
  "properties": {
    "schema": {"const": "sm64-saturn-mesh-ir"},
    "version": {"const": 2},
    "name": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "static_world_space": {"const": true},
    "positions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/position"}
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "rgb555"],
        "properties": {
          "id": {"type": "integer", "minimum": 0},
          "rgb555": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 0, "maximum": 31},
              {"type": "integer", "minimum": 0, "maximum": 31},
              {"type": "integer", "minimum": 0, "maximum": 31}
            ],
            "minItems": 3,
            "maxItems": 3
          }
        },
        "additionalProperties": true
      }
    },
    "triangles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "material", "indices"],
        "properties": {
          "source": {"type": "integer", "minimum": 0},
          "material": {"type": "integer", "minimum": 0},
          "indices": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 0},
              {"type": "integer", "minimum": 0},
              {"type": "integer", "minimum": 0}
            ],
            "minItems": 3,
            "maxItems": 3
          },
          "texture_tile": {"$ref": "#/$defs/textureTile"}
        },
        "additionalProperties": false
      }
    },
    "vertex_attributes": {
      "type": "object",
      "properties": {
        "uv": {"type": "array", "items": {"$ref": "#/$defs/uv"}}
      },
      "additionalProperties": false
    },
    "pairing_forbidden_triangles": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 0}
    },
    "deformation": {
      "type": ["object", "null"],
      "properties": {
        "mode": {"enum": ["linear_blend", "goddard_weighted_accumulation"]},
        "joint_count": {"type": "integer", "minimum": 1},
        "joints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "influences": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["joint", "weight_q15"],
              "properties": {
                "joint": {"type": "integer", "minimum": 0},
                "weight_q15": {"type": "integer", "minimum": 0, "maximum": 32768}
              },
              "additionalProperties": false
            }
          }
        }
      },
      "required": ["mode", "joint_count", "influences"],
      "additionalProperties": false
    },
    "validation_poses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "positions"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "positions": {"type": "array", "items": {"$ref": "#/$defs/position"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "position": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": -32768, "maximum": 32767},
        {"type": "integer", "minimum": -32768, "maximum": 32767},
        {"type": "integer", "minimum": -32768, "maximum": 32767}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "uv": {
      "type": "array",
      "prefixItems": [{"type": "integer"}, {"type": "integer"}],
      "minItems": 2,
      "maxItems": 2
    },
    "textureTile": {
      "type": "object",
      "required": ["texture", "state"],
      "properties": {
        "texture": {"type": ["string", "null"]},
        "state": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
