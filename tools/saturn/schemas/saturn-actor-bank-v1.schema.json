{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sm64-saturn-actor-bank-v1.schema.json",
  "$comment": "Advisory report-shape schema only. compile_actor_bank.validate_actor_bank_document is the authoritative semantic, provenance, and payload validator.",
  "title": "SM64 Saturn actor bank report v1",
  "type": "object",
  "required": [
    "schema", "version", "magic", "family_id", "model_id", "joint_count",
    "animation_count", "meshlet_count", "primitive_count", "vertex_count",
    "max_instances", "feature_mask", "source_sha256", "payload_sha256",
    "max_scratch", "sources", "animations", "vertices", "joints", "parts", "materials",
    "meshlets", "primitives"
  ],
  "properties": {
    "schema": {"const": "sm64-saturn-actor-bank-v1"},
    "version": {"const": 1},
    "magic": {"const": "S64B"},
    "animation_count": {"const": 209},
    "source_file_count": {"const": 193},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {"type": "array", "minItems": 196},
    "animations": {"type": "array", "minItems": 209, "maxItems": 209},
    "vertices": {"type": "array", "minItems": 1},
    "joints": {"type": "array", "minItems": 20, "maxItems": 20},
    "parts": {"type": "array", "minItems": 1},
    "materials": {"type": "array", "minItems": 1},
    "meshlets": {"type": "array", "minItems": 1},
    "primitives": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
